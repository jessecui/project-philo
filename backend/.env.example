# Google Cloud / Vertex AI Configuration
# For production deployment with service accounts

# Your Google Cloud project ID (required)
GOOGLE_CLOUD_PROJECT=your-project-id

# Vertex AI location/region (e.g., us-central1, us-east1, etc.)
VERTEX_AI_LOCATION=us-central1

# Note: For local development, you can use Application Default Credentials (ADC)
# gcloud auth application-default login

# Creator Authentication
# The name used to validate creator authentication (required)
CREATOR_NAME=creatorname